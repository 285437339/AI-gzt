{
  "name": "xie-mengxiong-workbench",
  "version": "1.0.29",
  "description": "谢梦雄创作台",
  "main": "electron-main.js",
  "private": true,
  "scripts": {
    "test:history": "node tests/history.cjs",
    "test:dropdowns": "node tests/dropdowns.cjs",
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "37.2.6",
    "electron-builder": "^26.0.12",
    "playwright": "^1.63.0",
    "vite": "^6.4.3"
  },
  "build": {
    "appId": "com.xiemengxiong.workbench",
    "productName": "谢梦雄创作台",
    "files": [
      "electron-main.js",
      "preload.js",
      "server.js",
      "index.html",
      "canvas-flow.bundle.js",
      "workbench-select.js",
      "workbench-state.js",
      "workbench-select.css",
      "xie-mengxiong-workbench.css",
      "generated/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "server.js"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "285437339",
      "repo": "AI-gzt"
    },
    "artifactName": "xie-mengxiong-workbench-setup-${version}.${ext}"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.0",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "electron-updater": "^6.8.9",
    "sharp": "^0.35.4",
    "vue": "^3.5.13"
  }
}
